{
  "name": "transmission-web-ui",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rpc": "node scripts/test-rpc.mjs",
    "test:installer": "bash tests/install/installer.test.sh && sh tests/install/embedded-helpers.test.sh",
    "test:installer:cwd": "sh tests/install/service-cwd.test.sh",
    "test:installer:login": "sh scripts/test-login-installer.sh",
    "test:login-entry": "node scripts/test-login-entry.mjs",
    "test:performance": "playwright test --project=chromium tests/e2e/performance.spec.ts",
    "lab:up": "docker compose -p twui-lab -f lab/compose.yaml --profile auth up -d --build",
    "lab:down": "docker compose -p twui-lab -f lab/compose.yaml --profile auth --profile fixtures --profile proxy down",
    "lab:seed": "node scripts/seed-lab.mjs",
    "release": "npm run build && node scripts/release.mjs",
    "package:nas": "node scripts/package-nas.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:size",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate rebuild-transmission-web-ui --strict --no-interactive",
    "test:deployment": "sh scripts/test-deployment.sh",
    "test:download": "node scripts/test-download.mjs",
    "test:match": "node scripts/test-match.mjs",
    "test:e2e:docker": "sh scripts/test-browsers-docker.sh",
    "check:size": "node scripts/check-size.mjs",
    "test:release:live": "node scripts/test-live-release.mjs",
    "test:soak": "TWUI_SOAK=1 playwright test --project=chromium tests/e2e/soak.spec.ts",
    "test:controls": "node scripts/test-controls.mjs",
    "test:diagnostics": "node scripts/test-diagnostics.mjs",
    "test:synocommunity": "node scripts/test-synocommunity.mjs",
    "compare:prepare": "node scripts/prepare-comparison.mjs",
    "compare:up": "npm run compare:prepare && docker compose -p twui-compare -f lab/compare.compose.yaml up -d --build --wait && node scripts/seed-comparison.mjs",
    "compare:down": "docker compose -p twui-compare -f lab/compare.compose.yaml down",
    "compare:reset": "node scripts/seed-comparison.mjs --reset",
    "compare:check": "node scripts/check-comparison.mjs",
    "test:compare": "sh scripts/test-browsers-docker.sh --config=playwright.compare.config.ts",
    "format": "prettier --write src tests scripts/*.mjs *.{ts,js,json}",
    "format:check": "prettier --check src tests scripts/*.mjs *.{ts,js,json}",
    "test:settings": "node scripts/test-settings.mjs",
    "build:replay": "vue-tsc --noEmit && vite build --mode replay --outDir artifacts/replay-build",
    "replay:diagnostics": "node scripts/replay-diagnostics.mjs",
    "test:diagnostics:unit": "vitest run tests/unit/diagnostics.test.ts tests/unit/diagnostics-capture.test.ts tests/unit/diagnostics-replay.test.ts",
    "test:diagnostics:replay": "npm run build:replay && node scripts/build-replay-fault-fixture.mjs && TWUI_PREVIEW_DIR=artifacts/replay-build TWUI_PREVIEW_PORT=4186 sh scripts/test-browsers-docker.sh tests/e2e/diagnostics*.spec.ts --grep-invert \"5000 tasks diagnostics overhead\"",
    "test:diagnostics:performance": "npm run build:replay && TWUI_PREVIEW_DIR=artifacts/replay-build TWUI_PREVIEW_PORT=4186 sh scripts/test-browsers-docker.sh tests/e2e/diagnostics-performance.spec.ts --project=chromium --workers=1"
  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "idb": "^8.0.0",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  }
}
